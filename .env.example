# Live analytics for the Mission Control dashboard.
# The existing Vercel project already has KV_REST_API_URL / KV_REST_API_TOKEN from
# the Vercel KV integration; those are picked up automatically. Either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: one-sentence AI pairing / match notes. Flavor choice never depends on this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Live Google rating + reviews (Places API, New). Google Cloud console → enable
# "Places API (New)" → create an API key restricted to that API.
GOOGLE_PLACES_API_KEY=
# Optional; found automatically from the store's name and address if blank.
GOOGLE_PLACE_ID=

# Catering inquiries go straight to Naina by email (https://resend.com, free tier).
CATERING_EMAIL_TO=
RESEND_API_KEY=
# Optional verified sender once a domain is set up in Resend:
# CATERING_EMAIL_FROM=Tifa Walnut Creek <catering@example.com>
